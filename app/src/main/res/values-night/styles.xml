<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:buttonStyle">@style/Button</item>
        <item name="android:actionBarStyle">@style/ActionBarDark</item>
    </style>
    <style name="ActionBarDark" parent="android:Widget.DeviceDefault.ActionBar.Solid">
        <item name="android:background">@color/brand</item>
        <item name="android:titleTextStyle">@style/ActionBarTitle</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
