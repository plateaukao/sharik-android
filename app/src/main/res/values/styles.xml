<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.Light">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:buttonStyle">@style/Button</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:dialogTheme">@style/AppDialog</item>
        <item name="android:actionBarStyle">@style/ActionBar</item>
    </style>

    <style name="ActionBar" parent="android:Widget.DeviceDefault.Light.ActionBar.Solid">
        <item name="android:background">@color/brand</item>
        <item name="android:titleTextStyle">@style/ActionBarTitle</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="ActionBarTitle" parent="android:TextAppearance.DeviceDefault.Widget.ActionBar.Title">
        <item name="android:textColor">@color/on_brand</item>
    </style>

    <!-- Flat, rounded, no shadow -->
    <style name="Button" parent="android:Widget.DeviceDefault.Light.Button">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Dialog buttons: borderless, brand-colored text. Set explicitly because some OEM themes
         (Onyx) route dialog buttons through buttonStyle, which would give white-on-white here. -->
    <style name="AppDialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:buttonStyle">@style/DialogButton</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DialogButton</item>
    </style>
    <style name="DialogButton" parent="android:Widget.DeviceDefault.Button.Borderless">
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
