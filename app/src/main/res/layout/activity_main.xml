<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/share_file" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="Share file…" />
        <Button android:id="@+id/share_text" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="Share text…" />
        <Button android:id="@+id/receive" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Receive" />
    </LinearLayout>

    <TextView android:id="@+id/empty"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:padding="24dp"
        android:textColor="?android:textColorSecondary"
        android:text="Share something — or send a file to Sharik from any app.\n\nShared items appear here; tap one to share it again." />

    <ListView android:id="@+id/history"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/clear_history" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="8dp"
            android:textColor="?android:textColorSecondary" android:textSize="13sp"
            android:text="Clear history" android:visibility="gone" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/device_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="8dp"
            android:textColor="?android:textColorSecondary" android:textSize="13sp"
            android:drawablePadding="6dp" />
    </LinearLayout>
</LinearLayout>
